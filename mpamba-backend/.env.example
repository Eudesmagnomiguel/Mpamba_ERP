# Environment variables for the Mpamba backend application
PORT=4000
NODE_ENV=development
WHATSAPP_NUMBER=+244999999999

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Postgres configuration
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=mpamba_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Prisma configuration
DATABASE_URL="postgresql://your_postgres_user:your_postgres_password@localhost:5432/mpamba_db?schema=public"

# JWT Configuration 
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=30m

# Email configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password

# Rate Limiting Configuration
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100

# Support Contact
WHATSAPP_NUMBER=+258843456789
